exports[`BTooltip > <b-tooltip label="Create" position="is-right" type="is-dark"><a class="add">x</a></b-tooltip> 1`] = `"<div data-v-app=""><div class="b-tooltip is-dark is-medium is-right"><div class="tooltip-content" style="display: none;">Create</div><div class="tooltip-trigger"><a class="add">x</a></div></div></div>"`;

exports[`BTooltip > <b-tooltip label="Create"><button>x</button></b-tooltip> (leave) 1`] = `"<div data-v-app=""><div class="b-tooltip is-medium is-primary is-top"><div class="tooltip-content" style="display: none;">Create</div><div class="tooltip-trigger"><button>x</button></div></div></div>"`;

exports[`BUpload+BIcon > <b-upload v-model="file" :disabled="true"><a>x</a></b-upload> 1`] = `"<div data-v-app=""><label class="control upload"><a>x</a><input data-live="false||file" disabled="" type="file"></label></div>"`;

exports[`BUpload+BIcon > <b-upload v-model="file" accept=".iso,application/x-iso9660-image" :disabled="false"><a class="create-btn"><b-icon icon="upload-outline" /><span>Upload ISO</span></a></b-upload> 1`] = `"<div data-v-app=""><label class="control upload"><a class="create-btn"><span class="icon"><i class="mdi mdi-24px mdi-upload-outline"></i></span><span>Upload ISO</span></a><input accept=".iso,application/x-iso9660-image" data-live="false||file" type="file"></label></div>"`;

exports[`BUpload+BIcon > <b-upload v-model="file" accept=".yaml,.yml" drag-drop expanded @invalid="got = 'bad'"><section class="section">Drop</section></b-upload><i>{{ file && file.name }}{{ got }}</i> (dropFile) 1`] = `"<div data-v-app=""><label class="control is-expanded upload"><div class="is-expanded is-primary upload-draggable"><section class="section">Drop</section></div><input accept=".yaml,.yml" data-live="false||file" type="file"></label><i>compose.yml</i></div>"`;

exports[`BUpload+BIcon > <b-upload v-model="file" accept=".yaml,.yml" drag-drop expanded @invalid="got = 'bad'"><section class="section">Drop</section></b-upload><i>{{ file && file.name }}{{ got }}</i> (dropFile) 2`] = `"<div data-v-app=""><label class="control is-expanded upload"><div class="is-expanded is-primary upload-draggable"><section class="section">Drop</section></div><input accept=".yaml,.yml" data-live="false||file" type="file"></label><i>bad</i></div>"`;

exports[`BUpload+BIcon > <b-upload v-model="file" accept=".yaml,.yml" drag-drop expanded @invalid="got = 'bad'"><section class="section">Drop</section></b-upload><i>{{ file && file.name }}{{ got }}</i> (hoverZone) 1`] = `"<div data-v-app=""><label class="control is-expanded upload"><div class="is-expanded is-hovered is-primary upload-draggable"><section class="section">Drop</section></div><input accept=".yaml,.yml" data-live="false||file" type="file"></label><i></i></div>"`;

