[Unit]
Description=NivaroOS watchdog (restart failed services, roll back a bad update)
Documentation=file:/usr/local/lib/nivaroos/nivaroos-watchdog
After=network.target

[Service]
Type=oneshot
ExecStart=/usr/local/lib/nivaroos/nivaroos-watchdog
# Never let the watchdog itself hang the next run.
TimeoutStartSec=5min
Nice=5
# Only the watchdog's own notices (restarts, rollbacks) - not systemd's
# Starting/Finished lines every 2 minutes. The script's own stdout/stderr
# (a bash error when it dies) is tagged warning, so it still gets through.
LogLevelMax=notice
SyslogLevel=warning
