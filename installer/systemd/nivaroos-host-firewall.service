[Unit]
Description=NivaroOS Host Desktop firewall (x11vnc TCP 5900 backstop, Smooth stream UDP 28650)
Documentation=file:/usr/local/lib/nivaroos/nivaroos-host-firewall
# After the distro's firewall (nftables.service flushes the ruleset) and the
# network, so the LAN interface (default route) and tailscale0 exist.
After=nftables.service ufw.service firewalld.service tailscaled.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/lib/nivaroos/nivaroos-host-firewall apply

[Install]
WantedBy=multi-user.target
