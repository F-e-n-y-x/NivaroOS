<?xml version="1.0" encoding="utf-8"?>
<!-- 3x2 by default; down to 3x1-ish and up to any size. Redrawn on each push
     from the app, and every 30 min so old data turns into "Not updated". -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="180dp"
    android:minHeight="110dp"
    android:minResizeWidth="180dp"
    android:minResizeHeight="90dp"
    android:targetCellWidth="3"
    android:targetCellHeight="2"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen"
    android:updatePeriodMillis="1800000"
    android:initialLayout="@layout/widget_server"
    android:previewLayout="@layout/widget_server"
    android:description="@string/widget_server_description" />
