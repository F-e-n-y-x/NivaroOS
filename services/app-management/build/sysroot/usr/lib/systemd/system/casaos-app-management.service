[Unit]
After=casaos-message-bus.service
After=docker.service
Description=Recasa App Management Service

[Service]
ExecStartPre=/usr/bin/recasa-app-management -v
ExecStart=/usr/bin/recasa-app-management -c /etc/recasa/app-management.conf
PIDFile=/var/run/recasa/app-management.pid
Restart=always
Type=notify

[Install]
WantedBy=multi-user.target
