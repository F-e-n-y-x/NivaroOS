[Unit]
After=nivaroos-message-bus.service
After=docker.service
Description=NivaroOS App Management Service

[Service]
ExecStartPre=/usr/bin/nivaroos-app-management -v
ExecStart=/usr/bin/nivaroos-app-management -c /etc/nivaroos/app-management.conf
PIDFile=/var/run/nivaroos/app-management.pid
Restart=always
Type=notify

[Install]
WantedBy=multi-user.target
