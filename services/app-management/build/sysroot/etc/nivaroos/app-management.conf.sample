[common]
RuntimePath = /var/run/nivaroos

[app]
LogPath = /var/log/nivaroos/
LogSaveName = app-management
LogFileExt = log
AppStorePath = /var/lib/nivaroos/appstore
AppsPath = /var/lib/nivaroos/apps

[server]
appstore = https://casaos.app/store/main.zip
appstore = https://github.com/bigbeartechworld/big-bear-casaos/archive/refs/heads/master.zip