[app]
PAGE_SIZE = 10
RuntimeRootPath = runtime/
LogPath = /var/log/recasa/
LogSaveName = log
LogFileExt = log
DateStrFormat = 20060102
DateTimeFormat = 2006-01-02 15:04:05
TimeFormat = 15:04:05
DateFormat = 2006-01-02
DBPath     = /var/lib/recasa
ShellPath  = /usr/share/recasa/shell
UserDataPath = /var/lib/recasa/conf

[server]
RunMode = release
ServerApi =
Handshake =
Token = 
USBAutoMount =

[system]