[Unit]
Description=rclone

[Service]
ExecStartPre=/usr/bin/mkdir -p /var/run/rclone 
ExecStartPre=/usr/bin/rm -f /var/run/rclone/rclone.sock
# The VFS write cache holds everything copied to a cloud drive until it
# has uploaded - on disk, not /tmp (RAM on many installs).
# Settings > Online storage > Cache can move it; local-storage writes the
# chosen folder to rclone-cache.env.
Environment=RCLONE_CACHE_DIR=/var/cache/nivaroos/rclone
EnvironmentFile=-/etc/nivaroos/rclone-cache.env
ExecStartPre=/usr/bin/mkdir -p ${RCLONE_CACHE_DIR}
ExecStart=/usr/bin/rclone rcd --rc-addr unix:///var/run/rclone/rclone.sock --rc-no-auth --rc-allow-origin "*" --cache-dir ${RCLONE_CACHE_DIR}
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target