[Unit]
After=casaos-gateway.service
After=casaos-message-bus.service
After=casaos-user-service.service
After=casaos.service
Before=docker.service
ConditionFileNotEmpty=/etc/recasa/local-storage.conf
Description=Recasa Local Storage Service

[Service]
ExecStartPre=/usr/bin/recasa-local-storage -v
ExecStart=/usr/bin/recasa-local-storage -c /etc/recasa/local-storage.conf
PIDFile=/var/run/recasa/local-storage.pid
Restart=always
Type=notify

[Install]
WantedBy=multi-user.target
