[Unit]
After=nivaroos-gateway.service
Description=NivaroOS Message Bus Service

[Service]
ExecStartPre=/usr/bin/nivaroos-message-bus -v
ExecStart=/usr/bin/nivaroos-message-bus -c /etc/nivaroos/message-bus.conf
PIDFile=/run/nivaroos/message-bus.pid
Restart=always
Type=notify
# Sandbox (security audit 2026-10, M3). Still uid 0 - same-host automation
# proves itself with the root-only token in /run/nivaroos (H1) - but with
# no capabilities at all (it writes only its notification feed in /var/lib/nivaroos/db),
# a read-only system (only the paths below are writable) and none of
# root's other powers, so a bug here can't be turned into the whole box.
ProtectSystem=strict
ProtectHome=read-only
RuntimeDirectory=nivaroos
RuntimeDirectoryPreserve=yes
LogsDirectory=nivaroos
ReadWritePaths=-/var/lib/nivaroos/db
CapabilityBoundingSet=
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectClock=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
RestrictNamespaces=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native
SystemCallFilter=@system-service
# An unexpected syscall fails instead of killing the service.
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
