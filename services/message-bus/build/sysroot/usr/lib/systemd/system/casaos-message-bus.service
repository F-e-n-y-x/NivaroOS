[Unit]
After=casaos-gateway.service
Description=Recasa Message Bus Service

[Service]
ExecStartPre=/usr/bin/nivaroos-message-bus -v
ExecStart=/usr/bin/nivaroos-message-bus -c /etc/nivaroos/message-bus.conf
PIDFile=/var/run/nivaroos/message-bus.pid
Restart=always
Type=notify

[Install]
WantedBy=multi-user.target
