[Unit]
# main.go's startup path calls Gateway().CreateRoute() and panics if it
# fails - it hard-requires the gateway to already be listening, not just
# "eventually". Only ordering after message-bus (not gateway too) worked
# by accident whenever the installer's own sequential, blocking
# `systemctl enable --now` loop happened to start gateway first - it is
# not guaranteed on a reboot or a manual `systemctl restart`, where
# systemd is free to start both in parallel.
After=nivaroos-message-bus.service nivaroos-gateway.service
Wants=nivaroos-gateway.service
Description=NivaroOS User Service

[Service]
ExecStartPre=/usr/bin/nivaroos-user -v
ExecStart=/usr/bin/nivaroos-user -c /etc/nivaroos/user-service.conf
PIDFile=/run/nivaroos/user-service.pid
Restart=always
Type=notify
# Sandbox (security audit 2026-10, M3). Still uid 0 - same-host automation
# proves itself with the root-only token in /run/nivaroos (H1) - but with
# no capabilities at all (it writes accounts, pictures and the session lists under /var/lib/nivaroos),
# a read-only system (only the paths below are writable) and none of
# root's other powers, so a bug here can't be turned into the whole box.
ProtectSystem=strict
ProtectHome=read-only
RuntimeDirectory=nivaroos
RuntimeDirectoryPreserve=yes
LogsDirectory=nivaroos
ReadWritePaths=-/var/lib/nivaroos
CapabilityBoundingSet=
NoNewPrivileges=true
PrivateTmp=true
ProtectClock=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
RestrictNamespaces=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native
SystemCallFilter=@system-service
# An unexpected syscall fails instead of killing the service.
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
