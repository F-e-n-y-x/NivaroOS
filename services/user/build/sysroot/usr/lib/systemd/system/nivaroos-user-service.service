[Unit]
# main.go's startup path calls Gateway().CreateRoute() and panics if it
# fails - it hard-requires the gateway to already be listening, not just
# "eventually". Only ordering after message-bus (not gateway too) worked
# by accident whenever the installer's own sequential, blocking
# `systemctl enable --now` loop happened to start gateway first - it is
# not guaranteed on a reboot or a manual `systemctl restart`, where
# systemd is free to start both in parallel.
After=nivaroos-message-bus.service nivaroos-gateway.service
Wants=nivaroos-gateway.service
Description=NivaroOS User Service

[Service]
ExecStartPre=/usr/bin/nivaroos-user -v
ExecStart=/usr/bin/nivaroos-user -c /etc/nivaroos/user-service.conf
PIDFile=/run/nivaroos/user-service.pid
Restart=always
Type=notify
# Defense-in-depth hardening that's safe regardless of this service's exact
# file-access footprint - none of these Go network/file-management daemons
# legitimately need kernel module loading, clock/hostname changes, realtime
# scheduling, or writable+executable memory, so blocking them costs nothing
# and closes off standard privilege-escalation/persistence paths for
# whatever a future RCE in this service might otherwise reach for.
# (ProtectSystem=strict/ReadWritePaths isn't applied here - this service's
# full file-access footprint isn't narrow/verified enough to allowlist
# without risking breaking a real write path, same reasoning already
# documented in the vm-sidecar/gpu-sidecar units.)
NoNewPrivileges=true
PrivateTmp=true
ProtectClock=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
MemoryDenyWriteExecute=true

[Install]
WantedBy=multi-user.target
